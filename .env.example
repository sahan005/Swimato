# Local SQLite:
DATABASE_URL="file:./dev.db"

# Production PostgreSQL (Neon / Supabase / Railway):
# Change `provider = "sqlite"` in prisma/schema.prisma to `provider = "postgresql"`
# and set DATABASE_URL="postgresql://user:pass@ep-xyz.aws.neon.tech/neondb?sslmode=require"

AUTH_SECRET="generate-a-32-byte-secret-via-openssl-rand-base64-32"
NEXTAUTH_URL="http://localhost:3000"
